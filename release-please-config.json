{
  "$schema": "https://github.com/googleapis/release-please/raw/refs/heads/main/schemas/config.json",
  "release-type": "simple",
  "changelog-sections": [
    { "type": "feat", "section": "✨ New Features" },
    { "type": "fix", "section": "🐛 Bug Fixes" },
    { "type": "perf", "section": "🚀 Performance Improvements" },
    { "type": "docs", "section": "📚 Documentation Updates" },
    { "type": "style", "section": "🎨 Code Style & Formatting" },
    { "type": "refactor", "section": "🧹 Code Refactoring" },
    { "type": "test", "section": "🧪 Tests" },
    { "type": "revert", "section": "Reverts", "hidden": true },
    { "type": "chore", "section": "Miscellaneous Chores", "hidden": true },
    { "type": "build", "section": "Build System", "hidden": true },
    { "type": "ci", "section": "Continuous Integration", "hidden": true }
  ],
  "include-v-in-tag": false,
  "pull-request-title-pattern": "chore(release):${component} ${version}",
  "pull-request-header": "🚀 Release Proposal",
  "pull-request-footer": "This PR was automatically generated by [Release Please](https://github.com/googleapis/release-please).",
  "separate-pull-requests": true,
  "always-update": true,
  "tag-separator": "/",
  "initial-version": "1.0.0",
  "packages": {
    ".": {
      "exclude-paths": ["docs", "tests", "themes"]
    },
    "themes": {
      "package-name": "gitkraken-themes",
      "extraFiles": {
        "type": "generic",
        "path": "default.nix"
      }
    }
  }
}
